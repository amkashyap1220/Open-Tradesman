# Copy to .env for local dev. On Render, set these as environment variables.
# NEVER put these in the frontend.

# Database: SQLite works for local dev; use Supabase/Neon Postgres in production.
DATABASE_URL=sqlite:///./dev.db
# Postgres role that can only SELECT (used by the "ask anything" box). Optional locally.
DATABASE_URL_READONLY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# PayPal sandbox (https://developer.paypal.com -> Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's Webhooks section (subscribe to INVOICING.INVOICE.PAID)
PAYPAL_WEBHOOK_ID=

# Speech-to-text via Cloudflare Workers AI (Whisper)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Where the app is served from (CORS)
APP_ORIGIN=http://localhost:5173
