// Cloudflare Worker serving the built PWA at tradesman.alexanderk.dev.
// Deploy: npm run deploy  (or connect this repo in the Cloudflare dashboard with root dir "frontend").
{
  "name": "open-tradesman-app",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "tradesman.alexanderk.dev", "custom_domain": true }]
}
